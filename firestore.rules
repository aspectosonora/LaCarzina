rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedText(field, max) {
      return field is string && field.size() > 0 && field.size() <= max;
    }

    match /comandas/{id} {
      allow read: if resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;

      // Demo para sitio estÃ¡tico sin Auth: permite crear comandas con expiraciÃ³n mÃ¡xima de 31 dÃ­as.
      // ProducciÃ³n recomendada: mover la creaciÃ³n a Cloud Functions/Admin SDK y dejar create/update/delete en false.
      allow create: if signedText(request.resource.data.pedidoId, 80)
        && signedText(request.resource.data.folio, 20)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      allow update, delete: if false;
    }

    match /clientes/{clienteId} {
      // Demo sin Auth: el menÃº puede crear/actualizar datos reutilizables del cliente.
      // ProducciÃ³n recomendada: proteger con Auth, App Check o Cloud Functions.
      allow create, update: if request.resource.data.telefono is string;
      allow read, delete: if false;
    }

    match /pedidos/{pedidoId} {
      allow create: if signedText(request.resource.data.folio, 20)
        && request.resource.data.total is number;
      allow read, update, delete: if false;
    }

    match /puntos_movimientos/{movimientoId} {
      allow create: if request.resource.data.puntos is number
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /config/folio_counter {
      // Necesario solo si el contador se incrementa desde el cliente web.
      // ProducciÃ³n recomendada: incrementar folios desde Cloud Functions/Admin SDK.
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /config/menu_hoy {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
